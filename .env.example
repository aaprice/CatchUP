# ---- engine selection (lib/llm.py reads these) ----
LLM_PROVIDER=ollama            # ollama | openai (any OpenAI-compatible: Gemini, vLLM, LM Studio)
LLM_MODEL=qwen3:8b             # see SETUP.md VRAM table
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=16384           # context window per request. Bigger = more VRAM.
# LLM_THINK=0                  # qwen3/gpt-oss: 0 disables thinking (faster), 1 forces it. Unset = model default.
EMBED_MODEL=nomic-embed-text

# ---- OpenAI-compatible provider (Gemini free tier example) ----
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_API_KEY=your-ai-studio-key
# LLM_MODEL=gemini-flash-latest
# EMBED_MODEL=gemini-embedding-001

# ---- DGX / vLLM example ----
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://dgx-host:8000/v1
# OPENAI_API_KEY=dummy
# LLM_MODEL=Qwen/Qwen3-32B
